private theorem border_index_checked (index : Fin 376) : borderCheck index = true := by
  let chunk : Fin 47 := ⟨index.val / 8, by omega⟩
  have checked := List.all_eq_true.mp (border_chunks chunk) (index.val % 8)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have reconstructed :
      (⟨(8 * chunk.val + index.val % 8) % 376, Nat.mod_lt _ (by decide)⟩ : Fin 376) =
        index := by
    apply Fin.ext
    dsimp only [chunk]
    omega
  simpa only [reconstructed] using checked

private def borderStates : List BorderState := borderRaw.toList.map borderRow

/-- Membership in the fixed 376-state halo invariant of the selected substitution. -/
def BorderState.Admissible (state : BorderState) : Prop := state ∈ borderStates

private theorem borderStateAt_mem (index : Fin 376) : (borderStateAt index).Admissible := by
  apply List.mem_map.mpr
  exact ⟨borderRaw[index.val]'(by rw [borderRaw_size]; exact index.isLt),
    Array.getElem_mem_toList (by rw [borderRaw_size]; exact index.isLt), rfl⟩

private theorem exists_borderStateAt {state : BorderState} (h : state.Admissible) :
    ∃ index : Fin 376, borderStateAt index = state := by
  obtain ⟨row, hrow, rfl⟩ := List.mem_map.mp h
  obtain ⟨i, hi, hrow⟩ := Array.mem_iff_getElem.mp (Array.mem_toList_iff.mp hrow)
  refine ⟨⟨i, by simpa only [borderRaw_size] using hi⟩, ?_⟩
  simp only [borderStateAt, hrow]

private theorem border_checked {state : BorderState} (h : state.Admissible) :
    (∀ x y : Fin 2,
      state.halo.row x.castSucc y.castSucc = state.node.rowInterior x y ∧
      state.halo.column x.castSucc y.castSucc = state.node.columnInterior x y) ∧
    (∀ childX childY : Fin 4, (state.refine childX childY).Admissible) ∧
    (∀ childX childY : Fin 4, (state.refine childX childY).node.parent = 0 →
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 0 ∧
        state.xParity = 0 ∧ state.yParity = 0) ∨
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 4 ∧
        state.xParity = 1 ∧ state.yParity = 1) ∨
      (childX = 2 ∧ childY = 2 ∧ state.xParity = 0 ∧ state.yParity = 0)) := by
  obtain ⟨index, rfl⟩ := exists_borderStateAt h
  have checked := of_decide_eq_true (border_index_checked index)
  refine ⟨checked.1, ?_, checked.2.2⟩
  intro childX childY
  rw [checked.2.1 childX childY]
  exact borderStateAt_mem _

/-- The persistent outer-border seed belongs to the concrete halo invariant. -/
theorem BorderState.seed_admissible : BorderState.seed.Admissible := by
  have seed : BorderState.seed = borderStateAt 375 := by decide +kernel
  rw [seed]
  exact borderStateAt_mem _

/-- Every certified halo observation is the actual selected shade boundary at that quarter. -/
theorem BorderState.observations {state : BorderState} (h : state.Admissible) (x y : Fin 2) :
    state.halo.row x.castSucc y.castSucc = state.node.rowInterior x.val y.val ∧
    state.halo.column x.castSucc y.castSucc = state.node.columnInterior x.val y.val :=
  (border_checked h).1 x y

/-- All sixteen refinements of an admissible halo remain in the concrete invariant. -/
theorem BorderState.refine_admissible {state : BorderState} (h : state.Admissible)
    (childX childY : Fin 4) : (state.refine childX childY).Admissible :=
  (border_checked h).2.1 childX childY

/-- Every index-zero child has one of the three certified origin configurations. -/
theorem BorderState.corner_transition {state : BorderState} (h : state.Admissible)
    (childX childY : Fin 4) (corner : (state.refine childX childY).node.parent = 0) :
    (childX = 0 ∧ childY = 0 ∧ state.node.parent = 0 ∧
      state.xParity = 0 ∧ state.yParity = 0) ∨
    (childX = 0 ∧ childY = 0 ∧ state.node.parent = 4 ∧
      state.xParity = 1 ∧ state.yParity = 1) ∨
    (childX = 2 ∧ childY = 2 ∧ state.xParity = 0 ∧ state.yParity = 0) :=
  (border_checked h).2.2 childX childY corner

