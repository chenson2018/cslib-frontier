private theorem checked_from_chunks (check : Node → Bool)
    (chunks : ∀ chunk : Fin 39, (List.range 8).all (fun offset =>
      check ⟨⟨(8 * chunk.val + offset) % 312, Nat.mod_lt _ (by decide)⟩⟩) = true)
    (node : Node) : check node = true := by
  let chunk : Fin 39 := ⟨node.code.val / 8, by omega⟩
  have checked := List.all_eq_true.mp (chunks chunk) (node.code.val % 8)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have reconstructed :
      (⟨⟨(8 * chunk.val + node.code.val % 8) % 312,
        Nat.mod_lt _ (by decide)⟩⟩ : Node) = node := by
    cases node with
    | mk code =>
      apply congrArg Node.mk
      apply Fin.ext
      dsimp only [chunk]
      omega
  simpa only [reconstructed] using checked

private theorem seam_checked (node : Node) : seamCheck node = true :=
  checked_from_chunks seamCheck seam_chunks node


private theorem cached_correct (node : Node) : cachedSeams node = actualSeams node :=
  (of_decide_eq_true (seam_checked node)).1

private theorem hCompatible_cached (left right : Node) :
    HCompatible left right ↔ (cachedSeams left).east = (cachedSeams right).west := by
  rw [cached_correct left, cached_correct right]
  simp [actualSeams, HCompatible, seamCode_eq_iff, ShadeBlock.hMatches, ShadeBlock.at]

private theorem vCompatible_cached (lower upper : Node) :
    VCompatible lower upper ↔ (cachedSeams lower).north = (cachedSeams upper).south := by
  rw [cached_correct lower, cached_correct upper]
  simp [actualSeams, VCompatible, seamCode_eq_iff, ShadeBlock.vMatches, ShadeBlock.at]

private theorem pair_checked (left right : Node) : pairCheck left right = true := by
  have hl := of_decide_eq_true (seam_checked left)
  have hr := of_decide_eq_true (seam_checked right)
  apply decide_eq_true
  constructor
  · intro h y
    apply (hCompatible_cached _ _).mpr
    calc
      _ = hExpansion (cachedSeams left).east y := hl.2.2.1 y
      _ = hExpansion (cachedSeams right).west y := by
        rw [(hCompatible_cached left right).mp h]
      _ = _ := (hr.2.1 y).symm
  · intro h x
    apply (vCompatible_cached _ _).mpr
    calc
      _ = vExpansion (cachedSeams left).north x := hl.2.2.2.2 x
      _ = vExpansion (cachedSeams right).south x := by
        rw [(vCompatible_cached left right).mp h]
      _ = _ := (hr.2.2.2.1 x).symm

private theorem node_checked (node : Node) : nodeCheck node = true :=
  checked_from_chunks nodeCheck node_chunks node

/-- Every quarter of a selected node satisfies the actual local shade rule. -/
theorem Node.block_allowed (node : Node) (x y : Fin 2) :
    RedShades.locallyAllowed ⟨node.parent, quadrantAt x.val y.val⟩
      (node.block.at x.val y.val) = true := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.1 x y

/-- All four internal shade seams of a selected node match. -/
theorem Node.block_internal (node : Node) :
    node.block.southwest.east = node.block.southeast.west ∧
    node.block.northwest.east = node.block.northeast.west ∧
    node.block.southwest.north = node.block.northwest.south ∧
    node.block.southeast.north = node.block.northeast.south := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.2.1

/-- The chosen child has exactly the parent prescribed by two Robinson substitutions. -/
theorem Node.child_parent (node : Node) (position : Fin 16) :
    (node.child position).parent = fineGrid node.parent (position.val % 4) (position.val / 4) := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.2.2.1 position

/-- The sparse southwest child retains the preceding shade block. -/
theorem Node.child_zero_block (node : Node) : (node.child 0).block = node.block := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.2.2.2.1

/-- Horizontal neighbors within a selected expansion are compatible. -/
theorem children_hCompatible_within (node : Node) (x : Fin 3) (y : Fin 4) :
    HCompatible (node.child (blockPosition ⟨x.val, by omega⟩ y))
      (node.child (blockPosition ⟨x.val + 1, by omega⟩ y)) := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.2.2.2.2.1 x y

/-- Vertical neighbors within a selected expansion are compatible. -/
theorem children_vCompatible_within (node : Node) (x : Fin 4) (y : Fin 3) :
    VCompatible (node.child (blockPosition x ⟨y.val, by omega⟩))
      (node.child (blockPosition x ⟨y.val + 1, by omega⟩)) := by
  have h := node_checked node
  simp only [nodeCheck, decide_eq_true_eq] at h
  exact h.2.2.2.2.2 x y

/-- Expansion preserves horizontal matching across neighboring parent blocks. -/
theorem children_hCompatible_boundary {left right : Node}
    (compatible : HCompatible left right) (y : Fin 4) :
    HCompatible (left.child (blockPosition 3 y)) (right.child (blockPosition 0 y)) := by
  have h := pair_checked left right
  simp only [pairCheck, decide_eq_true_eq] at h
  exact h.1 compatible y

/-- Expansion preserves vertical matching across neighboring parent blocks. -/
theorem children_vCompatible_boundary {lower upper : Node}
    (compatible : VCompatible lower upper) (x : Fin 4) :
    VCompatible (lower.child (blockPosition x 3)) (upper.child (blockPosition x 0)) := by
  have h := pair_checked lower upper
  simp only [pairCheck, decide_eq_true_eq] at h
  exact h.2 compatible x

/-- The chosen canonical seed decorates corrected Robinson index zero. -/
theorem seedNode_parent : seedNode.parent = 0 := by decide +kernel

/-- Selected vertical-border orientation in a node's quarter; true means east interior. -/
@[expose] def Node.rowInterior (node : Node) (x y : ℕ) : Option Bool :=
  Signals.horizontalInteriorCode <|
    ShadedSignals.selectedVerticalFor (components node.parent).thick
      (quadrantAt x y) (node.block.at x y)

/-- Selected horizontal-border orientation in a node's quarter; true means north interior. -/
@[expose] def Node.columnInterior (node : Node) (x y : ℕ) : Option Bool :=
  Signals.verticalInteriorCode <|
    ShadedSignals.selectedHorizontalFor (components node.parent).thick
      (quadrantAt x y) (node.block.at x y)

/-- The row and column observations on a three-by-three quarter halo. -/
structure BorderHalo where
  /-- Selected vertical boundaries, indexed by quarter x and y. -/
  row : Fin 3 → Fin 3 → Option Bool
  /-- Selected horizontal boundaries, indexed by quarter x and y. -/
  column : Fin 3 → Fin 3 → Option Bool

/-- Decide extensional halo equality by its finite pointwise characterization. -/
instance : DecidableEq BorderHalo := fun first second =>
  decidable_of_iff
    (∀ x y : Fin 3, first.row x y = second.row x y ∧ first.column x y = second.column x y)
    (by
      constructor
      · intro h
        have rows := funext fun x => funext fun y => (h x y).1
        have columns := funext fun x => funext fun y => (h x y).2
        cases first
        cases second
        simp only [BorderHalo.mk.injEq]
        exact ⟨rows, columns⟩
      · intro h
        cases h
        intro x y
        exact ⟨rfl, rfl⟩)

/-- A decorated node, its coordinate parities, and the surrounding selected-border halo. -/
structure BorderState where
  /-- The decorated Robinson node. -/
  node : Node
  /-- Parity of the node's horizontal block coordinate. -/
  xParity : Fin 2
  /-- Parity of the node's vertical block coordinate. -/
  yParity : Fin 2
  /-- The visible two-by-two patch together with its one-cell halo. -/
  halo : BorderHalo

/-- Decide equality of the node, parities, and finite halo observations. -/
instance : DecidableEq BorderState := fun first second =>
  decidable_of_iff
    (first.node = second.node ∧ first.xParity = second.xParity ∧
      first.yParity = second.yParity ∧ first.halo = second.halo)
    (by cases first; cases second; simp only [BorderState.mk.injEq])

/-- Round a coordinate up to the next multiple of four, then divide by four. -/
@[expose] def ceilDivFour (coordinate : ℕ) : ℕ := (coordinate + 3) / 4

/-- Lift a selected border through two substitutions, retaining its oriented child edge. -/
@[expose] def liftBorder (coordinate : ℕ) : Option Bool → Option Bool
  | none => none
  | some true => if coordinate % 4 = 1 then some true else none
  | some false => if coordinate % 4 = 0 then some false else none

/-- The newly created depth-zero frame: residues two and three inside a period of four. -/
@[expose] def baseFrame (coordinate transverse : ℕ) : Option Bool :=
  if 2 ≤ transverse % 4 ∧ transverse % 4 ≤ 3 then
    if coordinate % 4 = 2 then some true
    else if coordinate % 4 = 3 then some false else none
  else none

/-- The persistent opening on the west or south edge of a seed supertile. -/
@[expose] def outerBorder (coordinate transverse : ℕ) : Option Bool :=
  if coordinate = 1 ∧ 1 ≤ transverse then some true else none

/-- The outer-border seed state, before any decorated expansion. -/
@[expose] def BorderState.seed : BorderState where
  node := seedNode
  xParity := 0
  yParity := 0
  halo.row x y := outerBorder x y
  halo.column x y := outerBorder y x

/-- Refine the node and its halo at one position of the selected four-by-four expansion. -/
@[expose] def BorderState.refine (state : BorderState) (childX childY : Fin 4) : BorderState where
  node := state.node.child (blockPosition childX childY)
  xParity := ⟨childX.val % 2, Nat.mod_lt _ (by decide)⟩
  yParity := ⟨childY.val % 2, Nat.mod_lt _ (by decide)⟩
  halo.row x y :=
    let coarseX : Fin 3 := ⟨ceilDivFour (2 * childX.val + x.val), by
      dsimp only [ceilDivFour]; omega⟩
    let coarseY : Fin 3 := ⟨ceilDivFour (2 * childY.val + y.val), by
      dsimp only [ceilDivFour]; omega⟩
    (liftBorder (2 * childX.val + x.val) (state.halo.row coarseX coarseY)).or
      (liftBorder (2 * childX.val + x.val)
        (baseFrame (2 * state.xParity.val + coarseX.val)
          (2 * state.yParity.val + coarseY.val)))
  halo.column x y :=
    let coarseX : Fin 3 := ⟨ceilDivFour (2 * childX.val + x.val), by
      dsimp only [ceilDivFour]; omega⟩
    let coarseY : Fin 3 := ⟨ceilDivFour (2 * childY.val + y.val), by
      dsimp only [ceilDivFour]; omega⟩
    (liftBorder (2 * childY.val + y.val) (state.halo.column coarseX coarseY)).or
      (liftBorder (2 * childY.val + y.val)
        (baseFrame (2 * state.yParity.val + coarseY.val)
          (2 * state.xParity.val + coarseX.val)))

private def decodeBorder : ℕ → Option Bool
  | 0 => none
  | 1 => some false
  | _ => some true

private def borderRow (raw : BorderRow) : BorderState where
  node := ⟨⟨raw.node % 312, Nat.mod_lt _ (by decide)⟩⟩
  xParity := ⟨raw.blockXParity % 2, Nat.mod_lt _ (by decide)⟩
  yParity := ⟨raw.blockYParity % 2, Nat.mod_lt _ (by decide)⟩
  halo.row x y := decodeBorder ((haloPatterns.getD raw.haloIndex #[]).getD (x.val + 3 * y.val) 0)
  halo.column x y :=
    decodeBorder ((haloPatterns.getD raw.haloIndex #[]).getD (9 + x.val + 3 * y.val) 0)

private theorem borderRaw_size : borderRaw.size = 376 := by decide +kernel

private def borderStateAt (index : Fin 376) : BorderState :=
  borderRow (borderRaw[index.val]'(by rw [borderRaw_size]; exact index.isLt))

private def borderTarget (index : Fin 376) (x y : Fin 4) : Fin 376 :=
  ⟨((borderTargetCodes.getD index.val 0) / 376 ^ (x.val + 4 * y.val)) % 376,
    Nat.mod_lt _ (by decide)⟩

private def borderCheck (index : Fin 376) : Bool :=
  let state := borderStateAt index
  decide (
    (∀ x y : Fin 2,
      state.halo.row x.castSucc y.castSucc = state.node.rowInterior x y ∧
      state.halo.column x.castSucc y.castSucc = state.node.columnInterior x y) ∧
    (∀ childX childY : Fin 4,
      state.refine childX childY = borderStateAt (borderTarget index childX childY)) ∧
    (∀ childX childY : Fin 4, (state.refine childX childY).node.parent = 0 →
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 0 ∧
        state.xParity = 0 ∧ state.yParity = 0) ∨
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 4 ∧
        state.xParity = 1 ∧ state.yParity = 1) ∨
      (childX = 2 ∧ childY = 2 ∧ state.xParity = 0 ∧ state.yParity = 0)))

private def borderChunk (chunk : ℕ) : Bool :=
  (List.range 8).all fun offset =>
    borderCheck ⟨(8 * chunk + offset) % 376, Nat.mod_lt _ (by decide)⟩

