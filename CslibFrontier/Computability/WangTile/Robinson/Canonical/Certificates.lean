/-- The source seed, raw node ID zero. -/
@[expose] def seedNode : Node := ⟨311⟩

/-- Row-major position in a four-by-four child block. -/
@[expose] def blockPosition (x y : Fin 4) : Fin 16 := ⟨x.val + 4 * y.val, by omega⟩

/-- Compatibility of both the parent Wang edges and the two horizontal shade seams. -/
@[expose] def HCompatible (left right : Node) : Prop :=
  (tile (components left.parent)).right = (tile (components right.parent)).left ∧
    left.block.hMatches right.block = true

/-- Compatibility of both the parent Wang edges and the two vertical shade seams. -/
@[expose] def VCompatible (lower upper : Node) : Prop :=
  (tile (components lower.parent)).top = (tile (components upper.parent)).bottom ∧
    lower.block.vMatches upper.block = true

/-- Decide horizontal compatibility from parent edges and shade seams. -/
instance : DecidableRel HCompatible := fun left right =>
  inferInstanceAs (Decidable
    ((tile (components left.parent)).right = (tile (components right.parent)).left ∧
      left.block.hMatches right.block = true))

/-- Decide vertical compatibility from parent edges and shade seams. -/
instance : DecidableRel VCompatible := fun lower upper =>
  inferInstanceAs (Decidable
    ((tile (components lower.parent)).top = (tile (components upper.parent)).bottom ∧
      lower.block.vMatches upper.block = true))

private def nodeCheck (node : Node) : Bool := decide (
  (∀ x y : Fin 2, RedShades.locallyAllowed ⟨node.parent, quadrantAt x y⟩
    (node.block.at x y) = true) ∧
  (node.block.southwest.east = node.block.southeast.west ∧
    node.block.northwest.east = node.block.northeast.west ∧
    node.block.southwest.north = node.block.northwest.south ∧
    node.block.southeast.north = node.block.northeast.south) ∧
  (∀ position : Fin 16, (node.child position).parent =
    fineGrid node.parent (position.val % 4) (position.val / 4)) ∧
  ((node.child 0).block = node.block) ∧
  (∀ (x : Fin 3) (y : Fin 4), HCompatible
    (node.child (blockPosition ⟨x.val, by omega⟩ y))
    (node.child (blockPosition ⟨x.val + 1, by omega⟩ y))) ∧
  (∀ (x : Fin 4) (y : Fin 3), VCompatible
    (node.child (blockPosition x ⟨y.val, by omega⟩))
    (node.child (blockPosition x ⟨y.val + 1, by omega⟩))))

private def nodeChunk (chunk : ℕ) : Bool :=
  (List.range 8).all fun offset =>
    nodeCheck ⟨⟨(8 * chunk + offset) % 312, Nat.mod_lt _ (by decide)⟩⟩

private def pairCheck (left right : Node) : Bool := decide (
  (HCompatible left right → ∀ y : Fin 4, HCompatible
    (left.child (blockPosition 3 y)) (right.child (blockPosition 0 y))) ∧
  (VCompatible left right → ∀ x : Fin 4, VCompatible
    (left.child (blockPosition x 3)) (right.child (blockPosition x 0))))

